#!/usr/bin/env python3

import os, socket, sys, threading
from http.server import HTTPServer, BaseHTTPRequestHandler
from pathlib import Path
from socketserver import ThreadingMixIn
from urllib.error import HTTPError
from urllib.parse import urlparse
from urllib.request import urlopen

####################
addr, port = "127.0.0.1", 3142
idle_timeout = 30

cache_dir = Path(os.environ.get("CACHE_DIR", "/var/cache/apt/proxy"))
cache_dir.mkdir(exist_ok=True)

active = 0
active_guard = threading.Lock()

locked = {}
locked_guard = threading.Lock()

####################
def lock_for(cache):
    with locked_guard:
        return locked.setdefault(cache, threading.Lock())

class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        sys.stderr.write((fmt % args).translate(self._control_char_table) + "\n")

    def send_ok(self, deb=False, length=None):
        self.send_response(200)
        if deb: self.send_header("Content-Type", "application/vnd.debian.binary-package")
        if length: self.send_header("Content-Length", length)
        self.end_headers()

    def send_and_cache_deb(self, cache):
        cache.parent.mkdir(parents=True, exist_ok=True)
        temp = cache.with_suffix(".partial")
        with urlopen(self.path) as resp:
            self.send_ok(deb=True, length=resp.headers.get("Content-Length"))
            with open(temp, "wb") as fp:
                try:
                    while chunk := resp.read(65536):
                        fp.write(chunk)
                        self.wfile.write(chunk)
                except: temp.unlink()
                else: temp.rename(cache)

    def send_cached_deb(self, cache):
        with open(cache, "rb") as fp:
            self.send_ok(deb=True, length=cache.stat().st_size)
            while chunk := fp.read(65536): self.wfile.write(chunk)

    def send_non_deb(self):
        with urlopen(self.path) as resp:
            self.send_ok(length=resp.headers.get("Content-Length"))
            while chunk := resp.read(65536): self.wfile.write(chunk)

    def do_GET(self):
        global active, active_guard, idle_timer
        with active_guard:
            active += 1
            idle_timer.cancel()

        try:
            data = urlparse(self.path)
            path = Path(data.path)
            if path.suffix == ".deb":
                cache = cache_dir / data.hostname / path.name

                if cache.exists(): self.send_cached_deb(cache)
                else:
                    with lock_for(cache):
                        if cache.exists(): self.send_cached_deb(cache)
                        else: self.send_and_cache_deb(cache)

            else: self.send_non_deb()

        except (BrokenPipeError, ConnectionResetError):
            pass # client disconnected

        except HTTPError as e:
            self.send_error(e.code)

        except Exception as e:
            self.send_error(502, str(e))

        finally:
            with active_guard:
                active -= 1
                if not active:
                    idle_timer = threading.Timer(idle_timeout, server.shutdown)
                    idle_timer.start()

class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    pass

####################
if os.environ.get("LISTEN_FDS", 0):
    sock = socket.fromfd(3, socket.AF_INET, socket.SOCK_STREAM)
    server = ThreadedHTTPServer((addr, port), Handler, bind_and_activate=False)
    server.socket = sock

else:
    if len(sys.argv) > 1:
        p1, _, p2 = sys.argv[1].partition(':')
        addr = p1 or addr
        port = int(p2) if p2 else port
    print(f"Listening on {addr}:{port}")
    server = ThreadedHTTPServer((addr, port), Handler)

idle_timer = threading.Timer(idle_timeout, server.shutdown)
idle_timer.start()
server.serve_forever()
